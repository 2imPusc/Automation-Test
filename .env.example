# ══════════════════════════════════════════════════════
# SHOPIFY AUTOTEST — Environment Config Template
# ══════════════════════════════════════════════════════
# Copy file này thành .env và điền thông tin thật vào.
# File .env KHÔNG commit lên git.


# ── Store (dùng chung cho mọi môi trường) ────────────
# Lấy từ URL: admin.shopify.com/store/[STORE_HANDLE]
STORE_HANDLE=your-store-handle


# ── App Handles: Local / Production ──────────────────
# Lấy từ URL: Admin → Apps → click app → /apps/[handle]

AVADA_PLAZA_HANDLE=your-avada-plaza-handle
SEO_HANDLE=your-seo-handle
BLOGS_HANDLE=your-blogs-handle


# ── App Handles: Staging ──────────────────────────────
# Handle staging cố định cho từng app (không đổi theo branch)
# Chạy staging: ENV=staging npm run test

STAGING_AVADA_PLAZA_HANDLE=your-staging-avada-plaza-handle
STAGING_SEO_HANDLE=your-staging-seo-handle
STAGING_BLOGS_HANDLE=your-staging-blogs-handle


# ── GitLab Integration ────────────────────────────────
# Personal Access Token với scope: read_api
# Tạo tại: GitLab → Avatar → Edit profile → Access Tokens

GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_URL=https://gitlab.com

