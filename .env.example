# Shopify Configuration
# Tên tài khoản Shopify (store handle)
STORE_HANDLE=your-store-handle

# ── App Handles ──────────────────────────────────────────────────────────────
# Lấy handle bằng cách: vào Admin → Apps → click app → nhìn URL: /apps/[handle]

AVADA_PLAZA_HANDLE=your-avada-plaza-handle
SEO_HANDLE=your-seo-handle
BLOGS_HANDLE=your-blogs-handle

# [Deprecated] APP_HANDLE vẫn được hỗ trợ như fallback cho avadaPlaza
# APP_HANDLE=your-app-handle
