# ══════════════════════════════════════════════════════
# SHOPIFY AUTOTEST WEB UI — Environment Config
# ══════════════════════════════════════════════════════
# Copy thành .env.local và điền thông tin thật.
# File .env.local KHÔNG commit lên git.

# ── Notion Integration ────────────────────────────────
# Lấy từ team lead (Avada Notion integration token)
AVADA_NOTION_TOKEN=ntn_...

# ── GitLab Integration ────────────────────────────────
# Tạo tại: GitLab → Avatar → Edit profile → Access Tokens → scope: read_api
GITLAB_TOKEN=glpat-...
GITLAB_URL=https://gitlab.com

# ── OpenClaw Gateway (AI — dùng Claude Max của bạn) ───
# Không cần Anthropic API key riêng — OpenClaw dùng subscription của bạn.
#
# Lấy token tại:
#   cat ~/.openclaw/openclaw.json | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['gateway']['auth']['token'])"
#
# Hoặc chạy script tiện lợi:
#   node scripts/get-gateway-token.js
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_gateway_token_here

# ── Claude Code CLI path ──────────────────────────────
# Đường dẫn tuyệt đối đến binary claude (cần cho pipeline gen-test).
#
# Lấy bằng lệnh:
#   macOS/Linux: which claude
#   Windows:     where.exe claude
#
# Ví dụ:
#   macOS:   /Users/[name]/.local/bin/claude
#   Windows: C:\Users\[name]\AppData\Roaming\npm\claude.cmd
#   WSL:     /home/[name]/.local/bin/claude
CLAUDE_PATH=/Users/your-name/.local/bin/claude

# ── Fallback (nếu không dùng OpenClaw) ───────────────
# Chỉ cần nếu không cài OpenClaw — không khuyến nghị
# ANTHROPIC_API_KEY=sk-ant-...
